{
  "name": "@zjunlp/orbit",
  "version": "0.1.1",
  "description": "Run, isolate and record experiments for coding agents",
  "keywords": [
    "experiments",
    "agent",
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./dist/plugin/skills"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./dist/plugin/cordis.patch.yml"
    }
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjunlp/Orbit.git",
    "directory": "packages/orbit"
  },
  "homepage": "https://github.com/zjunlp/Orbit#readme",
  "bugs": "https://github.com/zjunlp/Orbit/issues",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "bin": {
    "orbit": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./contracts": "./src/contracts/index.ts",
    "./naming": "./src/contracts/naming.ts",
    "./metrics": "./src/contracts/metrics.ts",
    "./taxonomy": "./src/contracts/taxonomy.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      "./contracts": {
        "types": "./dist/contracts.d.mts",
        "import": "./dist/contracts.mjs"
      },
      "./naming": {
        "types": "./dist/naming.d.mts",
        "import": "./dist/naming.mjs"
      },
      "./metrics": {
        "types": "./dist/metrics.d.mts",
        "import": "./dist/metrics.mjs"
      },
      "./taxonomy": {
        "types": "./dist/taxonomy.d.mts",
        "import": "./dist/taxonomy.mjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "tsdown && node scripts/copy-assets.ts",
    "prepack": "pnpm -w build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "commander": "15.0.0",
    "hono": "4.13.11",
    "smol-toml": "1.9.0",
    "uqr": "0.1.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.6-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "0.23.0"
  }
}
