{
  "name": "agent-infra-workspace",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "check": "node src/web/scripts/generate-review.mjs --check && biome check . && pnpm --filter @agent-infra/web typecheck",
    "format": "biome check --write .",
    "build": "pnpm --filter @agent-infra/web build",
    "contracts": "node src/web/scripts/generate-review.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13"
  }
}
